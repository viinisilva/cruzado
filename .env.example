# Copy to .env and adjust. Never commit .env. No value here is a real secret.

# --- Database ---
# Docker Compose builds DATABASE_URL from POSTGRES_PASSWORD. For local dev without Docker,
# leave DATABASE_URL empty to use the embedded PGlite database in .data/pglite.
POSTGRES_PASSWORD=troque-esta-senha-local
DATABASE_URL=
# PGLITE_DIR=.data/pglite

# --- App ---
# Public URL. When it starts with https:// the session cookie is marked Secure.
APP_URL=http://localhost:3000
APP_PORT=3000
# 32 random bytes in base64, used to encrypt connector tokens at rest (future Open Finance adapters).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Run the agent scheduler inside the app process (1) or use `npm run worker` (0).
ENABLE_INPROCESS_SCHEDULER=1
SCHEDULER_INTERVAL_MS=60000
# Vercel: the scheduler above is ignored; vercel.json calls /api/cron/agents with this secret.
CRON_SECRET=

# --- Open Finance (read-only, through Pluggy). See docs/OPEN_FINANCE.md ---
# From the Pluggy dashboard. Server-side only: never expose with NEXT_PUBLIC_.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# The one Cruzado account allowed to link banks. An id, not an e-mail: e-mails are not verified at signup.
PLUGGY_OWNER_USER_ID=
# personal = Meu Pluggy, Item ID colado à mão. connect = widget oficial (exige contrato Pluggy para desenvolvedores).
# Lido também no build: mudar exige novo deploy, porque abre a origem do widget na CSP.
PLUGGY_MODE=personal
# Conectores de teste no widget. Só em desenvolvimento: 1 liga.
PLUGGY_INCLUDE_SANDBOX=
# Enviado pela Pluggy no cabeçalho Authorization. Registre com scripts/pluggy-webhook.ts.
PLUGGY_WEBHOOK_SECRET=
# Public doors. Empty = open, unless PLUGGY_OWNER_USER_ID is set: an instance with an owner holds real data and
# starts closed. 0 always closes; 1 always opens.
ALLOW_SIGNUP=
ALLOW_DEMO=
# 1 stops the app from applying migrations at boot, so it can run with a role that cannot change the schema.
# Preview and Development deployments never migrate.
SKIP_AUTO_MIGRATE=

# --- WhatsApp Business Cloud API (official). See docs/WHATSAPP.md. Server-side only, never NEXT_PUBLIC_ ---
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=
# Explicit Graph API version in use, such as vX.Y. Check the current one in Meta's docs.
META_GRAPH_API_VERSION=
# Digits only, for the wa.me link in Configurações. Optional.
WHATSAPP_DISPLAY_NUMBER=

# --- AI provider: mock | anthropic | ollama ---
# mock = deterministic demo mode, no external calls, no key needed.
AI_PROVIDER=mock

# Anthropic (external): users must give explicit consent in Configurações before the chat works.
ANTHROPIC_API_KEY=
# Model is configuration, not code. Leave empty for the app default.
ANTHROPIC_MODEL=
# low | medium | high
ANTHROPIC_EFFORT=medium

# Ollama (local). From Docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# --- Seed (npm run db:seed) ---
SEED_DEMO_EMAIL=demo@cruzado.local
# Leave empty to generate a random password printed once.
SEED_DEMO_PASSWORD=
